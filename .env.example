# Copy to .env for local runs, or set these in the Railway service Variables tab.
# None of them are required: the defaults are right for a container.

# Port the web app listens on. Railway injects PORT itself, so leave this unset there.
# PORT=12000

# Where the WhatsApp session, config and chat history live. Point this at the mounted
# volume so a redeploy does not log you out of WhatsApp.
# DATA_DIR=/data
# AUTH_DIR=/data/auth

# Mirror the log files to stdout so the platform can collect them.
# LOG_STDOUT=1

# Watchdog tuning.
# CHECK_INTERVAL=30
# FAIL_THRESHOLD=4
# MIN_UPTIME_BEFORE_TRUST=60

# Optional: seed the LLM key and owner number without opening the dashboard. The
# dashboard writes these to the volume anyway, so this is only a convenience for the
# very first boot.
# LLM_API_KEY=
# OWNER_NUMBER=
